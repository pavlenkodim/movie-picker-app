# Data base
PORT=3000
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
# Set to false for local docker postgres (no SSL), keep true for Neon
POSTGRES_SSL=false

# Secret key for JWT token
PRIVATE_KEY="<YOU PRIVATE_KEY>"

# TMDB API credentials
TMDB_API_URL="https://api.themoviedb.org/3"
TMDB_API_KEY="<YOU API KEY>"
TMDB_READ_ACCESS_TOKEN="<YOU READ ACCESS TOKEN>"

# Languages for movie translations (comma separated, English is the base)
LANGUAGES=ru

# AWS
AWS_ACCESS_KEY_ID="API ID"
AWS_SECRET_ACCESS_KEY="YOU API KEY"
AWS_REGION=eu-central-1
AWS_S3_BUCKET=bucket-s3

# Google OAuth
GOOGLE_CLIENT_ID="<YOU GOOGLE CLIENT ID>"